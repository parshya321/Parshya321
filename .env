# Generate each secret with:   openssl rand -hex 32
# (Use hex/alphanumeric values: passwords are embedded in connection URLs.)

# ---------------------------------------------------------------- Required secrets
JWT_KEY=
ASSET_SIGNING_KEY=
# Example: cdn.example.com,storage.example.net
ALLOWED_ORIGIN_HOSTS=

# ---------------------------------------------------------------- Databases
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_DB=vod_platform
MONGO_APP_USER=vod_app
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

# ---------------------------------------------------------------- API (optional)
API_PORT=8000
WEB_CONCURRENCY=4
CORS_ORIGINS=https://learn.example.com
ASSET_URL_TTL_SECONDS=21600
JWT_ALGORITHMS=HS256
JWT_AUDIENCE=
JWT_ISSUER=

# ---------------------------------------------------------------- Resources (optional)
MONGO_CACHE_GB=1
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------- Health checker (optional)
HC_INTERVAL=30
HC_TIMEOUT=5
HC_FAIL_THRESHOLD=3
HC_RECOVER_THRESHOLD=2
HC_DEEP=1